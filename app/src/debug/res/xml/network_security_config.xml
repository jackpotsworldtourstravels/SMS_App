<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-build-only: allows plain HTTP to the local dev machine's LAN IP
     so the app can reach the Flask dev server during local testing.
     Never merged into release builds. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.16</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
